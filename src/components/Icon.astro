  tour: '<path d="M4 12a8 8 0 1 0 2.3-5.6"/><path d="M4 4.5v4h4"/><path d="M10.5 9v6l4.5-3z"/>',
  stop: '<rect x="6.5" y="6.5" width="11" height="11" rx="1.5"/>',
  cart: '<path d="M3 4h2.2l2.3 11h10.2l2-8H6.3"/><circle cx="9" cy="19" r="1.4"/><circle cx="16.5" cy="19" r="1.4"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  back: '<path d="M10 6 4 12l6 6"/><path d="M4.5 12H20"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  minus: '<path d="M5 12h14"/>',
  trash: '<path d="M4.5 7h15M9.5 7V4.5h5V7M6.5 7l1 13h9l1-13"/>',
