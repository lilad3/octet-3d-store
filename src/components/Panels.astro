---
import Icon from './Icon.astro';
import StorePlan from './StorePlan.astro';
import { zones, store } from '../data/catalog.js';
---
<!-- fiche produit : panneau latéral (ordinateur) ou tiroir du bas (téléphone) -->
<aside id="sheet" class="sheet" aria-labelledby="sheet-name" tabindex="-1" hidden>
  <button type="button" class="icon-btn sheet-close" data-action="close-sheet" aria-label="Fermer la fiche">
    <Icon name="close" />
  </button>
  <div class="sheet-scroll">
    <figure class="sheet-photo" hidden></figure>
    <h2 id="sheet-name" class="sheet-name"></h2>
    <p class="sheet-meta"><span class="meta-code"></span><span class="meta-zone"></span><span class="meta-ref"></span></p>
    <p class="sheet-pitch"></p>
    <div class="sheet-buy">
      <p class="sheet-price"></p>
      <p class="sheet-stock"><i></i><span></span></p>
    </div>
    <dl class="sheet-specs"></dl>
    <p class="sheet-desc"></p>
  </div>
  <footer class="sheet-actions">
    <div class="qty" role="group" aria-label="Quantité">
      <button type="button" class="icon-btn" data-action="qty-minus" aria-label="Retirer un"><Icon name="minus" size={18} /></button>
      <output class="qty-value" aria-live="polite">1</output>
      <button type="button" class="icon-btn" data-action="qty-plus" aria-label="Ajouter un"><Icon name="plus" size={18} /></button>
    </div>
    <button type="button" class="btn btn-primary sheet-add" data-action="add-to-cart">
      <span class="add-label">Ajouter au panier</span>
    </button>
    {store.demo && <p class="fine">Prix et stock d'exemple : catalogue de démonstration.</p>}
  </footer>
</aside>

<!-- panier -->
<aside id="cart" class="sheet sheet--cart" aria-labelledby="cart-title" tabindex="-1" hidden>
  <header class="cart-head">
    <h2 id="cart-title">Panier</h2>
    <button type="button" class="icon-btn" data-action="close-cart" aria-label="Fermer le panier"><Icon name="close" /></button>
  </header>
  <div class="sheet-scroll">
    <ul class="cart-lines"></ul>
    <div class="cart-empty" hidden>
      <p class="cart-empty-title">Votre panier est vide.</p>
      <p>Les produits sont dans les rayons. Approchez-vous de l'un d'eux, puis touchez-le pour l'ajouter.</p>
      <button type="button" class="btn btn-secondary" data-action="plan"><Icon name="plan" size={18} />Ouvrir le plan</button>
    </div>
  </div>
  <footer class="sheet-actions cart-foot">
    <p class="cart-total"><span>Total</span><strong></strong></p>
    <button type="button" class="btn btn-light" data-action="go-till"><Icon name="arrowRight" size={18} />Aller en caisse</button>
    <p class="fine">Le paiement en ligne sera bientôt disponible. Votre panier reste enregistré sur cet appareil.</p>
  </footer>
</aside>

<!-- recherche : s'ouvre sans animation, on s'en sert souvent -->
<div id="search" class="overlay search" role="dialog" aria-modal="true" aria-label="Rechercher un produit" hidden>
  <div class="search-panel">
    <div class="search-field">
      <Icon name="search" />
      <input type="search" placeholder="Un produit, une marque, un rayon…" autocomplete="off" spellcheck="false" enterkeyhint="go"
        role="combobox" aria-expanded="true" aria-controls="search-results" aria-autocomplete="list" />
      <button type="button" class="icon-btn" data-action="close-search" aria-label="Fermer la recherche"><Icon name="close" /></button>
    </div>
    <ul id="search-results" class="search-results" role="listbox" aria-label="Résultats"></ul>
    <p class="search-foot"><kbd>↑</kbd><kbd>↓</kbd> choisir · <kbd>Entrée</kbd> y aller · <kbd>Échap</kbd> fermer</p>
  </div>
</div>

<!-- plan complet -->
<div id="plan" class="overlay plan" role="dialog" aria-modal="true" aria-labelledby="plan-title" hidden>
  <div class="plan-panel">
    <header class="plan-head">
      <h2 id="plan-title">Plan du magasin</h2>
      <div class="plan-tools">
        <button type="button" class="chip" data-action="tour"><Icon name="tour" size={16} /><span>Visite guidée</span></button>
        <button type="button" class="icon-btn" data-action="close-plan" aria-label="Fermer le plan"><Icon name="close" /></button>
      </div>
    </header>
    <div class="plan-body">
      <StorePlan interactive class="plan-big" />
      <ol class="plan-zones">
        {zones.map((z) => (
          <li>
            <button type="button" class="plan-zone" data-go-zone={z.id}>
              <span class="pz-code">{z.code}</span>
              <span class="pz-name">{z.name}</span>
              <span class="pz-blurb">{z.blurb}</span>
            </button>
          </li>
        ))}
      </ol>
    </div>
  </div>
</div>
