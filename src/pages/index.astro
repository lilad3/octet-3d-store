---
import { store } from '../data/catalog.js';
import Loader from '../components/Loader.astro';
import Hud from '../components/Hud.astro';
import Panels from '../components/Panels.astro';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/store.css';
---
<!doctype html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content">
<meta name="theme-color" content="#E4E0D9">
<meta name="description" content={`${store.name}, ${store.tagline.toLowerCase()} : entrez dans la boutique, parcourez les rayons en 3D et ajoutez vos produits au panier.`}>
<title>{store.name} · {store.tagline}</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231D1E21'/%3E%3Crect x='5' y='13' width='4' height='6' fill='%23CBA35A'/%3E%3Crect x='11' y='13' width='4' height='6' fill='%23CBA35A' opacity='.3'/%3E%3Crect x='17' y='13' width='4' height='6' fill='%23CBA35A'/%3E%3Crect x='23' y='13' width='4' height='6' fill='%23CBA35A'/%3E%3C/svg%3E">
<link rel="preload" href="/fonts/archivo-narrow-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/martian-mono-latin.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body>
<div id="scene" aria-hidden="true"></div>
<Loader />
<Hud />
<Panels />
<script>
  import '../scripts/store/main.js';
</script>
</body>
</html>
